@inherits LayoutComponentBase
@inject ThemeService ThemeService

<MudThemeProvider IsDarkMode="@_isDarkMode" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />
<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@(_drawerOpen ? Icons.Material.Filled.MenuOpen : Icons.Material.Filled.Menu)"
                       Color="Color.Inherit"
                       OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6">SilkHat</MudText>
        <MudSpacer />
        <MudSwitch T="bool"
                   @bind-checked="_isDarkMode"
                   @bind-checked:after="PersistDarkModeAsync"
                   Color="Color.Secondary" />
    </MudAppBar>
    <MudDrawer Open="@_drawerOpen" Elevation="1" ClipMode="DrawerClipMode.Always">
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="mt-6 px-0">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _isDarkMode;
    private bool _drawerOpen = true;

    protected override async Task OnInitializedAsync()
    {
        await ThemeService.InitializeAsync();
        _isDarkMode = ThemeService.IsDarkMode;
    }

    private Task PersistDarkModeAsync()
    {
        return ThemeService.SetDarkModeAsync(_isDarkMode);
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }
}
