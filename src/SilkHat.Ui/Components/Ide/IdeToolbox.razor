@using SilkHat.Ui.State.Ide
@inject IState<IdeSolutionsState> SolutionsState
@inject IState<IdeLayoutState> LayoutState

@if (SelectedToolboxView == IdeToolboxView.Decisions)
{
    <DecisionToolbox/>
}

@code {
    private string? SelectedSolutionId => SolutionsState.Value.SelectedSolutionId;

    private IdeToolboxView SelectedToolboxView
    {
        get
        {
            if (SelectedSolutionId is null)
            {
                return IdeToolboxView.None;
            }

            return LayoutState.Value.Views.TryGetValue(SelectedSolutionId, out var view)
                ? view.ToolboxView
                : IdeLayoutViewState.Default.ToolboxView;
        }
    }

}
