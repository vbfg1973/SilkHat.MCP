@inherits VisualizationComponentBase
@inject VisualizationThemeService VisualizationThemeService

<div class="ide-d3-viewer" id="@ContainerId"></div>

@code {
    [Parameter] public string? Label { get; set; }

    private string? _lastLabel;
    private string? _lastPaletteKey;

    protected override bool HasContent => !string.IsNullOrWhiteSpace(Label);

    protected override async Task RenderAsync(bool force)
    {
        var palette = VisualizationThemeService.GetPalette();
        var paletteKey = palette.GetKey();
        if (!force
            && string.Equals(_lastLabel, Label, StringComparison.Ordinal)
            && string.Equals(_lastPaletteKey, paletteKey, StringComparison.Ordinal))
        {
            return;
        }

        _lastLabel = Label;
        _lastPaletteKey = paletteKey;

        await JSRuntime.InvokeVoidAsync(
            "silkhatD3.render",
            ContainerId,
            new { label = Label },
            palette);
    }

    protected override Task ClearAsync()
    {
        _lastLabel = Label;
        _lastPaletteKey = null;
        return JSRuntime.InvokeVoidAsync("silkhatD3.clear", ContainerId).AsTask();
    }

}
