@using MudBlazor
@using SilkHat.Ui.Models

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            <MudText Typo="Typo.subtitle2">Annotation Metric</MudText>
            <MudSelect T="CodeTreeAnnotationKind?" Label="Metric" Dense="true" @bind-Value="_selected">
                <MudSelectItem T="CodeTreeAnnotationKind?" Value="@(null)">None</MudSelectItem>
                @foreach (var metric in Enum.GetValues<CodeTreeAnnotationKind>())
                {
                    <MudSelectItem T="CodeTreeAnnotationKind?" Value="@metric">@metric</MudSelectItem>
                }
            </MudSelect>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="Clear">Clear</MudButton>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Apply</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance? Dialog { get; set; }

    [Parameter]
    public CodeTreeAnnotationKind? AnnotationKind { get; set; }

    private CodeTreeAnnotationKind? _selected;

    protected override void OnInitialized()
    {
        _selected = AnnotationKind;
    }

    private void Save()
    {
        Dialog?.Close(DialogResult.Ok(new CodeTreeAnnotationSelection(_selected)));
    }

    private void Cancel()
    {
        Dialog?.Cancel();
    }

    private void Clear()
    {
        _selected = null;
        Dialog?.Close(DialogResult.Ok(new CodeTreeAnnotationSelection(null)));
    }
}
