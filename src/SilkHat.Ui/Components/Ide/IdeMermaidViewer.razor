@inherits VisualizationComponentBase
@inject VisualizationThemeService VisualizationThemeService

<div class="ide-mermaid-viewer" id="@ContainerId"></div>

@code {
    [Parameter] public string? Diagram { get; set; }

    private string? _lastDiagram;
    private string? _lastPaletteKey;

    protected override bool HasContent => !string.IsNullOrWhiteSpace(Diagram);

    protected override async Task RenderAsync(bool force)
    {
        var palette = VisualizationThemeService.GetPalette();
        var paletteKey = palette.GetKey();
        if (!force
            && string.Equals(_lastDiagram, Diagram, StringComparison.Ordinal)
            && string.Equals(_lastPaletteKey, paletteKey, StringComparison.Ordinal))
        {
            return;
        }

        _lastDiagram = Diagram;
        _lastPaletteKey = paletteKey;

        await JSRuntime.InvokeVoidAsync("silkhatMermaid.render", ContainerId, Diagram, palette);
    }

    protected override Task ClearAsync()
    {
        _lastDiagram = Diagram;
        _lastPaletteKey = null;
        return JSRuntime.InvokeVoidAsync("silkhatMermaid.clear", ContainerId).AsTask();
    }

}
