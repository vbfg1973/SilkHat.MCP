@using Fluxor
@using Fluxor.Blazor.Web.Components
@using MudBlazor
@using Microsoft.AspNetCore.Components.Web
@using SilkHat.Ui.Components.Ide
@using SilkHat.Ui.State.Ide
@using SilkHat.Ui.State.Ide.Actions
@using SilkHat.Ui.State.Ide.Models
@inherits FluxorComponent
@inject IState<IdeSolutionsState> SolutionsState
@inject IState<IdeTabsState> TabsState
@inject IState<IdeSymbolsState> SymbolsState
@inject IState<IdeLayoutState> LayoutState
@inject IDispatcher Dispatcher
@inject IDialogService DialogService

@if (TabsView?.OpenFiles.Count > 0)
{
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
        <IdeCommitCard />
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="CloseAllTabs">Close all tabs</MudButton>
        </MudStack>
    </MudStack>
    <MudTabs Rounded="true"
             Elevation="0"
             ActivePanelIndex="@TabsView!.ActiveTabIndex"
             ActivePanelIndexChanged="OnActiveTabChanged"
             Class="flex-grow-1 ide-mud-tabs">
        @for (var index = 0; index < TabsView.OpenFiles.Count; index++)
        {
            var file = TabsView.OpenFiles[index];
            var tabIndex = index;
            <MudTabPanel>
                <TabContent>
                    <div class="d-flex align-items-center gap-2">
                        <MudText Typo="Typo.body2">@file.Name</MudText>
                        <span @onclick:stopPropagation="true">
                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                           Size="Size.Small"
                                           Color="Color.Default"
                                           OnClick="@(async (MouseEventArgs _) => await CloseTabAsync(tabIndex))" />
                        </span>
                    </div>
                </TabContent>
                <ChildContent>
                    <div class="ide-tab-body" style="height: 100%;">
                        <div class="ide-file-tooling" style="height: 100%;">
                            <MudPaper Elevation="0" Class="pa-3 ide-file-panel">
                                <div class="ide-file-scroll">
                                    <div class="ide-file-content">
                                        @foreach (var line in file.RenderLines)
                                        {
                                            <div style="@GetLineStyle(line)">
                                                <span class="ide-file-line-number">@GetLineNumber(line)</span>
                                                <span class="ide-file-line-text" style="white-space: pre;">@line.Text</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </MudPaper>
                            @if (SelectedToolboxView != IdeToolboxView.None)
                            {
                                <IdeToolbox />
                            }
                        </div>
                    </div>
                </ChildContent>
            </MudTabPanel>
        }
    </MudTabs>
}

@code {
    private IDialogReference? _symbolDialog;
    private IdeTabsViewState? TabsView
    {
        get
        {
            if (SelectedSolutionId is null)
            {
                return null;
            }

            return TabsState.Value.Tabs.TryGetValue(SelectedSolutionId, out var view)
                ? view
                : IdeTabsViewState.Empty;
        }
    }

    private string? SelectedSolutionId => SolutionsState.Value.SelectedSolutionId;

    private IdeSymbolsViewState? SymbolsView
    {
        get
        {
            if (SelectedSolutionId is null)
            {
                return null;
            }

            return SymbolsState.Value.Views.TryGetValue(SelectedSolutionId, out var view)
                ? view
                : IdeSymbolsViewState.Empty;
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (SymbolsView?.IsOpen != true && _symbolDialog is not null)
        {
            _symbolDialog.Close();
            _symbolDialog = null;
        }
    }

    private Task CloseTabAsync(int index)
    {
        if (SelectedSolutionId is null)
        {
            return Task.CompletedTask;
        }

        Dispatcher.Dispatch(new CloseFileTabAction(SelectedSolutionId, index));
        return Task.CompletedTask;
    }

    private void CloseAllTabs()
    {
        if (SelectedSolutionId is null)
        {
            return;
        }

        Dispatcher.Dispatch(new CloseAllTabsAction(SelectedSolutionId));
    }


    private void OnActiveTabChanged(int index)
    {
        if (SelectedSolutionId is null)
        {
            return;
        }

        Dispatcher.Dispatch(new SetActiveTabAction(SelectedSolutionId, index));
    }

    private async Task OpenSymbolsPopup()
    {
        if (SelectedSolutionId is null)
        {
            return;
        }

        if (SymbolsView?.IsOpen == true)
        {
            return;
        }

        Dispatcher.Dispatch(new OpenSymbolPopupAction(SelectedSolutionId));
        _symbolDialog = await DialogService.ShowAsync<IdeSymbolPopup>(
            "File Symbols",
            new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true });
        var dialogRef = _symbolDialog;
        _ = dialogRef.Result.ContinueWith(_ => InvokeAsync(() =>
        {
            if (SelectedSolutionId is not null)
            {
                Dispatcher.Dispatch(new CloseSymbolPopupAction(SelectedSolutionId));
            }
        }));
    }

    private static string GetLineStyle(IdeAnnotatedLine line)
    {
        return line.Decoration switch
        {
            IdeLineDecoration.Added => "background-color: #e6f4ea;",
            IdeLineDecoration.Deleted => "background-color: #fce8e6;",
            IdeLineDecoration.Highlight => "background-color: #f1f3f4;",
            _ => string.Empty
        };
    }

    private static string GetLineNumber(IdeAnnotatedLine line)
    {
        return line.LineNumber?.ToString() ?? string.Empty;
    }

    private IdeToolboxView SelectedToolboxView
    {
        get
        {
            if (SelectedSolutionId is null)
            {
                return IdeToolboxView.None;
            }

            return LayoutState.Value.Views.TryGetValue(SelectedSolutionId, out var view)
                ? view.ToolboxView
                : IdeLayoutViewState.Default.ToolboxView;
        }
    }
}
