<MudDialog>
    <DialogContent>
        <DecisionToolboxContent/>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance Dialog { get; set; } = default!;

    private void Close()
    {
        Dialog.Close();
    }

}
