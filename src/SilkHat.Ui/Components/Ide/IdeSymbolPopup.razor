@using SilkHat.Ui.State.Ide
@using SilkHat.Ui.State.Ide.Actions
@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@inject IState<IdeSolutionsState> SolutionsState
@inject IState<IdeSymbolsState> SymbolsState
@inject IDispatcher Dispatcher
@inject IDialogService DialogService

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            <MudText Typo="Typo.h6">File Symbols</MudText>
            @if (!string.IsNullOrWhiteSpace(CurrentView?.Error))
            {
                <MudAlert Severity="Severity.Error">@CurrentView!.Error</MudAlert>
            }
            else if (CurrentView?.IsLoading == true)
            {
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium"/>
            }
            else if (CurrentView is null || CurrentView.Nodes.Count == 0)
            {
                <MudText Typo="Typo.body2">No symbols available for the current file.</MudText>
            }
            else
            {
                <MudTreeView T="CodeSymbolOutlineNodeModel" Items="@TreeItems">
                    <ItemTemplate>
                        <MudTreeViewItem T="CodeSymbolOutlineNodeModel"
                                         Value="@context.Value"
                                         Items="@context.Children"
                                         Text="@context.Text"
                                         Expanded="false"
                                         CanExpand="@context.Expandable"
                                         OnClick="@(() => OnSymbolSelected(context.Value!))">
                            <BodyContent Context="item">
                                <MudCard Elevation="0" Class="pa-2">
                                    <MudText Typo="Typo.subtitle2">@item.Value!.Name</MudText>
                                    <MudText Typo="Typo.caption">@item.Value!.SymbolKind</MudText>
                                    <MudText Typo="Typo.caption">@item.Value!.RealType</MudText>
                                </MudCard>
                            </BodyContent>
                        </MudTreeViewItem>
                    </ItemTemplate>
                </MudTreeView>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Default"
                   Disabled="@(!CanOpenCallStack)"
                   OnClick="OpenCallStack">
            Call Stack
        </MudButton>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance? Dialog { get; set; }

    private IDialogReference? _callStackDialog;

    private string? SelectedSolutionId => SolutionsState.Value.SelectedSolutionId;

    private IdeSymbolsViewState? CurrentView => SelectedSolutionId is null
        ? null
        : SymbolsState.Value.Views.TryGetValue(SelectedSolutionId, out var view)
            ? view
            : IdeSymbolsViewState.Empty;

    private IReadOnlyList<TreeItemData<CodeSymbolOutlineNodeModel>> TreeItems =>
        CurrentView is null ? Array.Empty<TreeItemData<CodeSymbolOutlineNodeModel>>() : BuildTree(CurrentView.Nodes);

    private CodeSymbolOutlineNodeModel? SelectedSymbolNode
        => CurrentView is null
            ? null
            : FindNode(CurrentView.Nodes, CurrentView.SelectedDocumentationId, CurrentView.SelectedSymbolKey);

    private bool CanOpenCallStack => SelectedSymbolNode is not null && IsMethodNode(SelectedSymbolNode);

    private static IReadOnlyList<TreeItemData<CodeSymbolOutlineNodeModel>> BuildTree(
        IReadOnlyList<CodeSymbolOutlineNodeModel> nodes)
    {
        return nodes.Select(BuildNode).ToList();
    }

    private static TreeItemData<CodeSymbolOutlineNodeModel> BuildNode(CodeSymbolOutlineNodeModel node)
    {
        var children = node.Children.Count == 0
            ? new List<TreeItemData<CodeSymbolOutlineNodeModel>>()
            : node.Children.Select(BuildNode).ToList();

        return new TreeItemData<CodeSymbolOutlineNodeModel>
        {
            Value = node,
            Text = node.Name,
            Expandable = children.Count > 0,
            Children = children
        };
    }

    private void OnSymbolSelected(CodeSymbolOutlineNodeModel node)
    {
        if (SelectedSolutionId is null)
        {
            return;
        }

        Dispatcher.Dispatch(new SelectSymbolNodeAction(SelectedSolutionId, node.DocumentationId, node.SymbolKey));
    }

    private async Task OpenCallStack()
    {
        if (SelectedSolutionId is null || SelectedSymbolNode is null)
        {
            return;
        }

        if (!IsMethodNode(SelectedSymbolNode))
        {
            return;
        }

        Dispatcher.Dispatch(new OpenCallStackPopupAction(
            SelectedSolutionId,
            SelectedSymbolNode.DocumentationId,
            SelectedSymbolNode.SymbolKey));
        if (_callStackDialog is not null)
        {
            return;
        }

        _callStackDialog = await DialogService.ShowAsync<IdeCallStackPopup>(
            "Method Call Stack",
            new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.ExtraLarge, FullWidth = true });
        var dialogRef = _callStackDialog;
        _ = dialogRef.Result.ContinueWith(_ => InvokeAsync(() =>
        {
            _callStackDialog = null;
            if (SelectedSolutionId is not null)
            {
                Dispatcher.Dispatch(new CloseCallStackPopupAction(SelectedSolutionId));
            }
        }));
    }

    private void Close()
    {
        if (SelectedSolutionId is not null)
        {
            Dispatcher.Dispatch(new CloseSymbolPopupAction(SelectedSolutionId));
        }

        Dialog?.Close();
    }

    private static CodeSymbolOutlineNodeModel? FindNode(
        IReadOnlyList<CodeSymbolOutlineNodeModel> nodes,
        string? documentationId,
        string? symbolKey)
    {
        if (!string.IsNullOrWhiteSpace(documentationId))
        {
            var docMatch = FindNodeByDocId(nodes, documentationId);
            if (docMatch is not null)
            {
                return docMatch;
            }
        }

        if (string.IsNullOrWhiteSpace(symbolKey))
        {
            return null;
        }

        foreach (var node in nodes)
        {
            if (string.Equals(node.SymbolKey, symbolKey, StringComparison.Ordinal))
            {
                return node;
            }

            var child = FindNode(node.Children, documentationId, symbolKey);
            if (child is not null)
            {
                return child;
            }
        }

        return null;
    }

    private static CodeSymbolOutlineNodeModel? FindNodeByDocId(
        IReadOnlyList<CodeSymbolOutlineNodeModel> nodes,
        string documentationId)
    {
        foreach (var node in nodes)
        {
            if (string.Equals(node.DocumentationId, documentationId, StringComparison.Ordinal))
            {
                return node;
            }

            var child = FindNodeByDocId(node.Children, documentationId);
            if (child is not null)
            {
                return child;
            }
        }

        return null;
    }

    private static bool IsMethodNode(CodeSymbolOutlineNodeModel node)
    {
        if (string.Equals(node.SymbolKind, "Method", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        return string.Equals(node.RealType, "Method", StringComparison.OrdinalIgnoreCase)
               || string.Equals(node.RealType, "Constructor", StringComparison.OrdinalIgnoreCase);
    }

}
