@page "/ide"
@inject RepositoryApiClient Api
@using System.Linq

<PageTitle>IDE</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">IDE View</MudText>

<MudPaper Elevation="1" Class="pa-4 mb-4">
    <MudSelect T="string"
               Label="Solution"
               Value="_selectedSolutionId"
               ValueChanged="OnSolutionChanged"
               Disabled="@(_availableSolutions.Count == 0)">
        @foreach (var solution in _availableSolutions)
        {
            <MudSelectItem T="string" Value="@solution.SolutionId">@solution.DisplayName</MudSelectItem>
        }
    </MudSelect>
    @if (!string.IsNullOrWhiteSpace(_solutionError))
    {
        <MudAlert Severity="Severity.Error" Class="mt-3">@_solutionError</MudAlert>
    }
</MudPaper>

<div style="width: 90vw; margin-left: 5vw; margin-right: 5vw;">
    <div class="d-flex gap-4">
        <MudPaper Elevation="1" Class="pa-3" Style="width: 320px; flex-shrink: 0;">
            <MudText Typo="Typo.subtitle1" Class="mb-2">Repository Tree</MudText>
            @if (!string.IsNullOrWhiteSpace(_currentState?.TreeError))
            {
                <MudAlert Severity="Severity.Error" Class="mb-2">@_currentState!.TreeError</MudAlert>
            }
            <MudTreeView T="CodeTreeEntryModel" ServerData="LoadTreeChildrenAsync" Items="_currentState?.TreeItems">
                <ItemTemplate>
                    <MudTreeViewItem T="CodeTreeEntryModel"
                                     Value="@context.Value"
                                     Text="@context.Text"
                                     Items="@context.Children"
                                     ItemsChanged="@(new Action<IReadOnlyCollection<TreeItemData<CodeTreeEntryModel>>>(items => OnItemsLoaded(context, items)))"
                                     @bind-Expanded="context.Expanded"
                                     CanExpand="@context.Expandable"
                                     Icon="@context.Icon"
                                     LoadingIconColor="Color.Info"
                                     OnClick="@(async (MouseEventArgs _) => await OnTreeEntrySelected(context.Value))" />
                </ItemTemplate>
            </MudTreeView>
        </MudPaper>
        <MudPaper Elevation="1" Class="pa-3 d-flex flex-column flex-grow-1" Style="min-width: 0;">
            @if (_currentState?.OpenFiles.Count > 0)
            {
                var activeFile = _currentState.OpenFiles.ElementAtOrDefault(_currentState.ActiveTabIndex);
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudCard Elevation="0" Class="pa-2" Style="min-width: 260px;">
                        <MudCardContent Class="pa-0">
                            @if (activeFile is null || !activeFile.HasCommitInfo)
                            {
                                <MudText Typo="Typo.body2">Last commit: unavailable</MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.subtitle2">@activeFile.AbbreviatedSha</MudText>
                                <MudText Typo="Typo.body2">@FormatCommitDate(activeFile.LastCommitDateUtc)</MudText>
                                <MudText Typo="Typo.body2">@activeFile.LastCommitAuthor</MudText>
                                <MudText Typo="Typo.body2">@activeFile.LastCommitAuthorEmail</MudText>
                            }
                            <MudCheckBox T="bool"
                                         Label="Show diff"
                                         @bind-Value="ActiveShowDiff"
                                         Disabled="@(activeFile is null)" />
                        </MudCardContent>
                    </MudCard>
                    <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="CloseAllTabs">Close all tabs</MudButton>
                </MudStack>
                <MudTabs Rounded="true" Elevation="0" @bind-ActivePanelIndex="_currentState.ActiveTabIndex" Class="flex-grow-1">
                    @for (var index = 0; index < _currentState.OpenFiles.Count; index++)
                    {
                        var file = _currentState.OpenFiles[index];
                        var tabIndex = index;
                        <MudTabPanel>
                            <TabContent>
                                <div class="d-flex align-items-center gap-2">
                                    <MudText Typo="Typo.body2">@file.Name</MudText>
                                    <span @onclick:stopPropagation="true">
                                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                       Size="Size.Small"
                                                       Color="Color.Default"
                                                       OnClick="@(async (MouseEventArgs _) => await CloseTabAsync(tabIndex))" />
                                    </span>
                                </div>
                            </TabContent>
                            <ChildContent>
                                <MudPaper Elevation="0" Class="pa-3" Style="height: 100%; overflow: auto;">
                                    <div style="font-family: Consolas, 'Courier New', monospace; font-size: 0.85rem; line-height: 1.4;">
                                        @foreach (var line in file.RenderLines)
                                        {
                                            <div style="@GetLineStyle(line)">
                                                <span style="display: inline-block; width: 3.5rem; color: #888;">@GetLineNumber(line)</span>
                                                <span>@line.Text</span>
                                            </div>
                                        }
                                    </div>
                                </MudPaper>
                            </ChildContent>
                        </MudTabPanel>
                    }
                </MudTabs>
            }
        </MudPaper>
    </div>
</div>

@code {
    private readonly List<SolutionEntry> _availableSolutions = new();
    private readonly Dictionary<string, SolutionViewState> _solutionStates = new(StringComparer.OrdinalIgnoreCase);
    private string? _selectedSolutionId;
    private SolutionViewState? _currentState;
    private string? _solutionError;

    protected override async Task OnInitializedAsync()
    {
        var configs = await Api.GetLoadedRepositoryConfigsAsync();
        foreach (var config in configs.Items)
        {
            foreach (var solution in config.Solutions.Where(item => item.IsEnabled))
            {
                _availableSolutions.Add(new SolutionEntry(
                    solution.SolutionId,
                    solution.RelativePath,
                    solution.RelativePath,
                    config.Id,
                    $"{solution.RelativePath} ({config.Name})"));
            }
        }

        _availableSolutions.Sort((left, right) =>
        {
            var nameComparison = string.Compare(left.DisplayName, right.DisplayName, StringComparison.OrdinalIgnoreCase);
            if (nameComparison != 0)
            {
                return nameComparison;
            }

            return string.Compare(left.SolutionId, right.SolutionId, StringComparison.OrdinalIgnoreCase);
        });

        if (_availableSolutions.Count == 0)
        {
            _solutionError = "No solutions are loaded.";
            return;
        }

        await OnSolutionChanged(_availableSolutions[0].SolutionId);
    }

    private async Task OnSolutionChanged(string? solutionId)
    {
        _selectedSolutionId = solutionId;
        _solutionError = null;
        if (string.IsNullOrWhiteSpace(_selectedSolutionId))
        {
            return;
        }

        if (_solutionStates.TryGetValue(_selectedSolutionId, out var existing))
        {
            _currentState = existing;
            return;
        }

        var entry = _availableSolutions.FirstOrDefault(solution =>
            string.Equals(solution.SolutionId, _selectedSolutionId, StringComparison.OrdinalIgnoreCase));
        if (entry is null)
        {
            _solutionError = "Solution not found.";
            return;
        }

        var state = new SolutionViewState(entry.ConfigId, entry.SolutionId);
        _solutionStates[entry.SolutionId] = state;
        _currentState = state;
        await LoadSolutionDataAsync(state, entry);
    }

    private async Task LoadSolutionDataAsync(SolutionViewState state, SolutionEntry entry)
    {
        if (state.TreeLoaded)
        {
            return;
        }

        try
        {
            var tree = await Api.GetCodeTreeAsync(entry.ConfigId, entry.SolutionId);
            state.TreeItems.AddRange(tree.Items.Select(BuildTreeItem));
            state.TreeLoaded = true;
        }
        catch (Exception ex)
        {
            state.TreeError = ex.Message;
        }
    }

    private async Task OnTreeEntrySelected(CodeTreeEntryModel? entry)
    {
        if (entry is null || entry.Type != CodeTreeEntryType.File || _currentState is null)
        {
            return;
        }

        var existingIndex = _currentState.OpenFiles.FindIndex(file =>
            string.Equals(file.RepositoryPath, entry.RepositoryPath, StringComparison.OrdinalIgnoreCase));
        if (existingIndex >= 0)
        {
            _currentState.ActiveTabIndex = existingIndex;
            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            var fileContent = await Api.GetCodeFileAsync(_currentState.ConfigId, _currentState.SolutionId, entry.DisplayPath);
            var tab = new OpenFileTab(
                entry.RepositoryPath,
                entry.DisplayPath,
                entry.Name,
                fileContent.Content);

            try
            {
                var lastChange = await Api.GetGitFileLastChangeAsync(_currentState.ConfigId, entry.RepositoryPath, false);
                tab.LastCommitAuthor = lastChange.Author;
                tab.LastCommitAuthorEmail = lastChange.AuthorEmail;
                tab.LastCommitDateUtc = lastChange.CommitDateUtc;
                tab.AbbreviatedSha = string.IsNullOrWhiteSpace(lastChange.AbbreviatedSha)
                    ? lastChange.CommitSha
                    : lastChange.AbbreviatedSha;
                tab.LastCommitSubject = lastChange.Subject;
            }
            catch
            {
                tab.LastCommitAuthor = null;
                tab.LastCommitAuthorEmail = null;
                tab.LastCommitDateUtc = null;
                tab.AbbreviatedSha = null;
            }

            _currentState.OpenFiles.Add(tab);
            _currentState.ActiveTabIndex = _currentState.OpenFiles.Count - 1;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            _currentState.TreeError = ex.Message;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ToggleDiffAsync(bool value)
    {
        if (_currentState is null)
        {
            return;
        }

        var index = _currentState.ActiveTabIndex;
        if (index < 0 || index >= _currentState.OpenFiles.Count)
        {
            return;
        }

        var file = _currentState.OpenFiles[index];
        if (value && !file.DiffLoaded)
        {
            try
            {
                var lastChange = await Api.GetGitFileLastChangeAsync(_currentState.ConfigId, file.RepositoryPath, true);
                file.LastCommitAuthor = lastChange.Author;
                file.LastCommitAuthorEmail = lastChange.AuthorEmail;
                file.LastCommitDateUtc = lastChange.CommitDateUtc;
                file.AbbreviatedSha = string.IsNullOrWhiteSpace(lastChange.AbbreviatedSha)
                    ? lastChange.CommitSha
                    : lastChange.AbbreviatedSha;
                file.LastCommitSubject = lastChange.Subject;
                file.DiffLines = lastChange.DiffLines.ToList();
                file.DiffLoaded = true;
            }
            catch (Exception ex)
            {
                _currentState.TreeError = ex.Message;
            }
        }

        file.ShowDiff = value;
        file.RenderLines = BuildAnnotatedLines(file.Content, file.DiffLines, file.ShowDiff);
        await InvokeAsync(StateHasChanged);
    }

    private bool ActiveShowDiff
    {
        get
        {
            if (_currentState is null)
            {
                return false;
            }

            var index = _currentState.ActiveTabIndex;
            if (index < 0 || index >= _currentState.OpenFiles.Count)
            {
                return false;
            }

            return _currentState.OpenFiles[index].ShowDiff;
        }
        set
        {
            _ = ToggleDiffAsync(value);
        }
    }

    private Task CloseTabAsync(int index)
    {
        if (_currentState is null)
        {
            return Task.CompletedTask;
        }

        if (index < 0 || index >= _currentState.OpenFiles.Count)
        {
            return Task.CompletedTask;
        }

        _currentState.OpenFiles.RemoveAt(index);
        if (_currentState.OpenFiles.Count == 0)
        {
            _currentState.ActiveTabIndex = 0;
            return Task.CompletedTask;
        }

        if (_currentState.ActiveTabIndex >= _currentState.OpenFiles.Count)
        {
            _currentState.ActiveTabIndex = _currentState.OpenFiles.Count - 1;
        }
        else if (_currentState.ActiveTabIndex > index)
        {
            _currentState.ActiveTabIndex -= 1;
        }

        return Task.CompletedTask;
    }

    private void CloseAllTabs()
    {
        if (_currentState is null)
        {
            return;
        }

        _currentState.OpenFiles.Clear();
        _currentState.ActiveTabIndex = 0;
    }

    private async Task<IReadOnlyCollection<TreeItemData<CodeTreeEntryModel>>> LoadTreeChildrenAsync(
        CodeTreeEntryModel? parent)
    {
        if (parent is null)
        {
            return _currentState?.TreeItems ?? new List<TreeItemData<CodeTreeEntryModel>>();
        }

        if (_currentState is null)
        {
            return Array.Empty<TreeItemData<CodeTreeEntryModel>>();
        }

        try
        {
            var children = await Api.GetCodeTreeAsync(_currentState.ConfigId, _currentState.SolutionId, parent.DisplayPath);
            return children.Items
                .Select(BuildTreeItem)
                .ToList();
        }
        catch (Exception ex)
        {
            _currentState.TreeError = ex.Message;
            return Array.Empty<TreeItemData<CodeTreeEntryModel>>();
        }
    }

    private static void OnItemsLoaded(
        TreeItemData<CodeTreeEntryModel> treeItemData,
        IReadOnlyCollection<TreeItemData<CodeTreeEntryModel>> children)
    {
        treeItemData.Children = children?.ToList() ?? new List<TreeItemData<CodeTreeEntryModel>>();
    }

    private static TreeItemData<CodeTreeEntryModel> BuildTreeItem(CodeTreeEntryModel entry)
    {
        return new TreeItemData<CodeTreeEntryModel>
        {
            Value = entry,
            Text = entry.Name,
            Icon = GetEntryIcon(entry),
            Expandable = entry.Type == CodeTreeEntryType.Project || entry.Type == CodeTreeEntryType.Directory,
            Expanded = false
        };
    }

    private static string GetEntryIcon(CodeTreeEntryModel entry)
    {
        return entry.Type switch
        {
            CodeTreeEntryType.Project => Icons.Material.Filled.AccountTree,
            CodeTreeEntryType.Directory => Icons.Material.Filled.Folder,
            _ => Icons.Material.Filled.Description
        };
    }

    private sealed record OpenFileTab(
        string RepositoryPath,
        string DisplayPath,
        string Name,
        string Content)
    {
        public string? LastCommitAuthor { get; set; }
        public string? LastCommitAuthorEmail { get; set; }
        public DateTimeOffset? LastCommitDateUtc { get; set; }
        public string? AbbreviatedSha { get; set; }
        public string? LastCommitSubject { get; set; }
        public bool HasCommitInfo =>
            LastCommitDateUtc.HasValue
            && !string.IsNullOrWhiteSpace(LastCommitAuthor)
            && !string.IsNullOrWhiteSpace(AbbreviatedSha)
            && !string.IsNullOrWhiteSpace(LastCommitAuthorEmail);
        public bool ShowDiff { get; set; }
        public bool DiffLoaded { get; set; }
        public List<GitFileDiffLineModel> DiffLines { get; set; } = new();
        public List<AnnotatedLine> RenderLines { get; set; } = BuildAnnotatedLines(Content, Array.Empty<GitFileDiffLineModel>(), false);
    }

    private enum LineDecoration
    {
        None = 0,
        Added = 1,
        Deleted = 2,
        Highlight = 3
    }

    private sealed record AnnotatedLine(int? LineNumber, string Text, LineDecoration Decoration);

    private static List<AnnotatedLine> BuildAnnotatedLines(
        string content,
        IReadOnlyList<GitFileDiffLineModel> diffLines,
        bool showDiff)
    {
        var normalized = content.Replace("\r\n", "\n").Replace('\r', '\n');
        var rawLines = normalized.Split('\n', StringSplitOptions.None);
        var deletionsByLine = new Dictionary<int, List<GitFileDiffLineModel>>();
        var additions = new HashSet<int>();

        if (showDiff)
        {
            foreach (var line in diffLines)
            {
                if (line.Kind == GitDiffLineKind.Add)
                {
                    additions.Add(line.LineNumber);
                }
                else
                {
                    if (!deletionsByLine.TryGetValue(line.LineNumber, out var bucket))
                    {
                        bucket = new List<GitFileDiffLineModel>();
                        deletionsByLine[line.LineNumber] = bucket;
                    }
                    bucket.Add(line);
                }
            }
        }

        var result = new List<AnnotatedLine>();
        for (var index = 0; index < rawLines.Length; index++)
        {
            var lineNumber = index + 1;
            if (deletionsByLine.TryGetValue(lineNumber, out var deletes))
            {
                foreach (var deleted in deletes)
                {
                    result.Add(new AnnotatedLine(lineNumber, deleted.Content, LineDecoration.Deleted));
                }
            }

            var decoration = additions.Contains(lineNumber) ? LineDecoration.Added : LineDecoration.None;
            result.Add(new AnnotatedLine(lineNumber, rawLines[index], decoration));
        }

        foreach (var key in deletionsByLine.Keys.Where(key => key > rawLines.Length).OrderBy(key => key))
        {
            foreach (var deleted in deletionsByLine[key])
            {
                result.Add(new AnnotatedLine(key, deleted.Content, LineDecoration.Deleted));
            }
        }

        return result;
    }

    private static string FormatCommitDate(DateTimeOffset? timestamp)
    {
        if (timestamp is null)
        {
            return string.Empty;
        }

        var utc = timestamp.Value.UtcDateTime;
        return utc.ToString("yyyy-MM-dd HH:mm:ss");
    }

    private static string GetLineStyle(AnnotatedLine line)
    {
        return line.Decoration switch
        {
            LineDecoration.Added => "background-color: #e6f4ea;",
            LineDecoration.Deleted => "background-color: #fce8e6;",
            LineDecoration.Highlight => "background-color: #f1f3f4;",
            _ => string.Empty
        };
    }

    private static string GetLineNumber(AnnotatedLine line)
    {
        return line.LineNumber?.ToString() ?? string.Empty;
    }

    private sealed record SolutionEntry(
        string SolutionId,
        string RelativePath,
        string Name,
        Guid ConfigId,
        string DisplayName);

    private sealed class SolutionViewState
    {
        public SolutionViewState(Guid configId, string solutionId)
        {
            ConfigId = configId;
            SolutionId = solutionId;
        }

        public Guid ConfigId { get; }
        public string SolutionId { get; }
        public List<TreeItemData<CodeTreeEntryModel>> TreeItems { get; } = new();
        public List<OpenFileTab> OpenFiles { get; } = new();
        public int ActiveTabIndex { get; set; }
        public string? TreeError { get; set; }
        public bool TreeLoaded { get; set; }
    }
}
