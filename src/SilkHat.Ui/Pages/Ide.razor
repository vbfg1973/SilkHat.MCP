@page "/ide"
@inject RepositoryApiClient Api

<PageTitle>IDE</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">IDE View</MudText>

<MudPaper Elevation="1" Class="pa-4 mb-4">
    <MudSelect T="Guid?"
               Label="Repository Config"
               Value="_selectedConfigId"
               ValueChanged="OnRepositoryChanged">
        <MudSelectItem T="Guid?" Value="@(default(Guid?))">Select a repository</MudSelectItem>
        @foreach (var config in _configs)
        {
            <MudSelectItem T="Guid?" Value="@config.Id">@config.Name</MudSelectItem>
        }
    </MudSelect>
    <MudSelect T="string"
               Label="Solution"
               Value="_selectedSolutionId"
               ValueChanged="OnSolutionChanged"
               Disabled="@(!_selectedConfigId.HasValue)"
               Class="mt-3">
        @foreach (var solution in _solutions)
        {
            <MudSelectItem T="string" Value="@solution.SolutionId">@solution.Name</MudSelectItem>
        }
    </MudSelect>
    @if (!string.IsNullOrWhiteSpace(_projectError))
    {
        <MudAlert Severity="Severity.Error" Class="mt-3">@_projectError</MudAlert>
    }
    @if (!string.IsNullOrWhiteSpace(_solutionError))
    {
        <MudAlert Severity="Severity.Error" Class="mt-3">@_solutionError</MudAlert>
    }
</MudPaper>

<MudGrid>
    <MudItem xs="12" md="3">
        <MudPaper Elevation="1" Class="pa-3">
            <MudText Typo="Typo.subtitle1" Class="mb-2">Repository Tree</MudText>
            @if (!string.IsNullOrWhiteSpace(_treeError))
            {
                <MudAlert Severity="Severity.Error" Class="mb-2">@_treeError</MudAlert>
            }
            <MudTreeView T="CodeTreeEntryModel" ServerData="LoadTreeChildrenAsync" Items="_treeItems">
                <ItemTemplate>
                    <MudTreeViewItem T="CodeTreeEntryModel"
                                     Value="@context.Value"
                                     Text="@context.Text"
                                    Items="@context.Children"
                                    ItemsChanged="@(new Action<IReadOnlyCollection<TreeItemData<CodeTreeEntryModel>>>(items => OnItemsLoaded(context, items)))"
                                    @bind-Expanded="context.Expanded"
                                    CanExpand="@context.Expandable"
                                    Icon="@context.Icon"
                                    LoadingIconColor="Color.Info"
                                     OnClick="@(async (MouseEventArgs _) => await OnTreeEntrySelected(context.Value))" />
                </ItemTemplate>
            </MudTreeView>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudPaper Elevation="1" Class="pa-3">
            <MudTabs Rounded="true" Elevation="0">
                <MudTabPanel Text="Welcome">
                    <MudText Typo="Typo.body2">
                        Select a repository and use this area for file tabs. Syntax highlighting and file viewing will follow.
                    </MudText>
                </MudTabPanel>
            </MudTabs>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="3">
        <MudPaper Elevation="1" Class="pa-3">
            <MudText Typo="Typo.subtitle1" Class="mb-2">File History</MudText>
            @if (_historyBusy)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mb-2" />
            }
            @if (!string.IsNullOrWhiteSpace(_historyError))
            {
                <MudAlert Severity="Severity.Error" Class="mb-2">@_historyError</MudAlert>
            }
            @if (!string.IsNullOrWhiteSpace(_selectedPath))
            {
                <MudText Typo="Typo.caption" Class="mb-2">@_selectedPath</MudText>
            }
            <MudList T="GitFileHistoryEntryModel" Dense="true">
                @foreach (var entry in _historyEntries)
                {
                    <MudListItem T="GitFileHistoryEntryModel">
                        <MudText Typo="Typo.body2">
                            @entry.CommitSha[..Math.Min(7, entry.CommitSha.Length)] - @entry.Message
                        </MudText>
                        <MudText Typo="Typo.caption">
                            @entry.Author | @entry.CommitDateUtc.ToLocalTime().ToString("g")
                        </MudText>
                    </MudListItem>
                }
            </MudList>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private readonly List<RepositoryConfigModel> _configs = new();
    private readonly List<CodeSolutionModel> _solutions = new();
    private readonly List<CodeProjectDto> _projects = new();
    private readonly List<TreeItemData<CodeTreeEntryModel>> _treeItems = new();
    private readonly List<GitFileHistoryEntryModel> _historyEntries = new();
    private Guid? _selectedConfigId;
    private string? _selectedSolutionId;
    private string? _projectError;
    private string? _solutionError;
    private string? _treeError;
    private string? _historyError;
    private bool _historyBusy;
    private string? _selectedPath;

    protected override async Task OnInitializedAsync()
    {
        _configs.AddRange(await Api.GetLoadedRepositoryConfigsAsync());
        _configs.Sort((left, right) => string.Compare(left.Name, right.Name, StringComparison.OrdinalIgnoreCase));
        if (_configs.Count > 0)
        {
            await OnRepositoryChanged(_configs[0].Id);
        }
    }

    private async Task OnRepositoryChanged(Guid? configId)
    {
        _selectedConfigId = configId;
        _selectedSolutionId = null;
        _solutions.Clear();
        _projects.Clear();
        _treeItems.Clear();
        _historyEntries.Clear();
        _projectError = null;
        _solutionError = null;
        _treeError = null;
        _historyError = null;
        _selectedPath = null;
        if (!configId.HasValue)
        {
            return;
        }

        try
        {
            var solutions = await Api.GetCodeSolutionsAsync(configId.Value);
            if (solutions.Count == 0)
            {
                _solutionError = "No solutions are loaded for this repository.";
                return;
            }

            _solutions.AddRange(solutions);
            _solutions.Sort((left, right) =>
            {
                var nameComparison = string.Compare(left.Name, right.Name, StringComparison.OrdinalIgnoreCase);
                if (nameComparison != 0)
                {
                    return nameComparison;
                }

                return string.Compare(left.RelativePath, right.RelativePath, StringComparison.OrdinalIgnoreCase);
            });
            _selectedSolutionId = _solutions[0].SolutionId;
        }
        catch (Exception ex)
        {
            _solutionError = ex.Message;
            return;
        }

        await LoadSolutionDataAsync(configId.Value, _selectedSolutionId);
    }

    private async Task OnSolutionChanged(string? solutionId)
    {
        _selectedSolutionId = solutionId;
        _projects.Clear();
        _treeItems.Clear();
        _projectError = null;
        _treeError = null;
        if (!_selectedConfigId.HasValue || string.IsNullOrWhiteSpace(_selectedSolutionId))
        {
            return;
        }

        await LoadSolutionDataAsync(_selectedConfigId.Value, _selectedSolutionId);
    }

    private async Task LoadSolutionDataAsync(Guid configId, string? solutionId)
    {
        if (string.IsNullOrWhiteSpace(solutionId))
        {
            return;
        }

        try
        {
            var projects = await Api.GetCodeProjectsAsync(configId, solutionId);
            _projects.AddRange(projects);
        }
        catch (Exception ex)
        {
            _projectError = ex.Message;
        }

        try
        {
            var tree = await Api.GetCodeTreeAsync(configId, solutionId);
            _treeItems.AddRange(tree.Select(BuildTreeItem));
        }
        catch (Exception ex)
        {
            _treeError = ex.Message;
        }
    }

    private async Task OnTreeEntrySelected(CodeTreeEntryModel? entry)
    {
        if (entry is null || entry.Type != CodeTreeEntryType.File || !_selectedConfigId.HasValue)
        {
            return;
        }

        _historyBusy = true;
        _historyError = null;
        _historyEntries.Clear();
        _selectedPath = entry.DisplayPath;
        try
        {
            var history = await Api.GetGitFileHistoryAsync(_selectedConfigId.Value, entry.RepositoryPath);
            _historyEntries.AddRange(history.Entries);
        }
        catch (Exception ex)
        {
            _historyError = ex.Message;
        }
        finally
        {
            _historyBusy = false;
        }
    }

    private async Task<IReadOnlyCollection<TreeItemData<CodeTreeEntryModel>>> LoadTreeChildrenAsync(
        CodeTreeEntryModel? parent)
    {
        if (parent is null)
        {
            return _treeItems;
        }

        if (!_selectedConfigId.HasValue || string.IsNullOrWhiteSpace(_selectedSolutionId))
        {
            return Array.Empty<TreeItemData<CodeTreeEntryModel>>();
        }

        try
        {
            var children = await Api.GetCodeTreeAsync(_selectedConfigId.Value, _selectedSolutionId, parent.DisplayPath);
            return children
                .Select(BuildTreeItem)
                .ToList();
        }
        catch (Exception ex)
        {
            _treeError = ex.Message;
            return Array.Empty<TreeItemData<CodeTreeEntryModel>>();
        }
    }

    private static void OnItemsLoaded(
        TreeItemData<CodeTreeEntryModel> treeItemData,
        IReadOnlyCollection<TreeItemData<CodeTreeEntryModel>> children)
    {
        treeItemData.Children = children?.ToList() ?? new List<TreeItemData<CodeTreeEntryModel>>();
    }

    private static TreeItemData<CodeTreeEntryModel> BuildTreeItem(CodeTreeEntryModel entry)
    {
        return new TreeItemData<CodeTreeEntryModel>
        {
            Value = entry,
            Text = entry.Name,
            Icon = GetEntryIcon(entry),
            Expandable = entry.Type == CodeTreeEntryType.Project || entry.Type == CodeTreeEntryType.Directory,
            Expanded = false
        };
    }

    private static string GetEntryIcon(CodeTreeEntryModel entry)
    {
        return entry.Type switch
        {
            CodeTreeEntryType.Project => Icons.Material.Filled.AccountTree,
            CodeTreeEntryType.Directory => Icons.Material.Filled.Folder,
            _ => Icons.Material.Filled.Description
        };
    }
}
