@page "/ide"
@using Fluxor
@using SilkHat.Ui.Components.Ide
@using SilkHat.Ui.State.Ide.Actions
@inject IDispatcher Dispatcher

<PageTitle>IDE</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">IDE View</MudText>

<MudPaper Elevation="1" Class="pa-4 mb-4">
    <IdeSolutionSelector />
</MudPaper>

<div class="ide-layout">
    <div class="d-flex ide-layout-row">
        <MudPaper Elevation="1" Class="pa-3 ide-tree-panel" Style="width: 320px; flex-shrink: 0; height: calc(100vh - 260px);">
            <IdeTree />
        </MudPaper>
        <div class="d-flex flex-column flex-grow-1 ide-tabs-panel" style="min-width: 0; height: calc(100vh - 260px); overflow: hidden;">
            <IdeTabs />
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        Dispatcher.Dispatch(new LoadSolutionsAction());
    }
}
