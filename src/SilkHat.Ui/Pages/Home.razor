@page "/"
@inject RepositoryApiClient Api

<PageTitle>Dashboard</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Repository Groups</MudText>
<MudPaper Elevation="1" Class="pa-4 mb-6">
    <MudGrid>
        <MudItem xs="12" md="5">
            <MudText Typo="Typo.subtitle1" Class="mb-2">@(_editingGroupId is null ? "Create Group" : "Edit Group")</MudText>
            <MudTextField T="string" Label="Name" Required="true" @bind-Value="_groupName" />
            <MudTextField T="string" Label="Description" @bind-Value="_groupDescription" Lines="3" />
            <MudStack Row="true" Class="mt-3" Spacing="2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveGroupAsync" Disabled="_groupBusy">
                    Save
                </MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="ClearGroupForm" Disabled="_groupBusy">
                    Clear
                </MudButton>
            </MudStack>
            @if (!string.IsNullOrWhiteSpace(_groupMessage))
            {
                <MudAlert Severity="Severity.Success" Class="mt-3">@_groupMessage</MudAlert>
            }
            @if (!string.IsNullOrWhiteSpace(_groupError))
            {
                <MudAlert Severity="Severity.Error" Class="mt-3">@_groupError</MudAlert>
            }
        </MudItem>
        <MudItem xs="12" md="7">
            <MudTable Items="_groups" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh>Description</MudTh>
                    <MudTh></MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Name">@context.Name</MudTd>
                    <MudTd DataLabel="Description">@context.Description</MudTd>
                    <MudTd>
                        <MudButton Variant="Variant.Text" OnClick="@(() => StartGroupEdit(context))">Edit</MudButton>
                    </MudTd>
                    <MudTd>
                        <MudButton Variant="Variant.Text" OnClick="@(() => StartGroupLoadAsync(context))" Disabled="_groupLoadBusy">
                            Load
                        </MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
            <MudDivider Class="my-4" />
            <MudText Typo="Typo.subtitle1">Group Load Results</MudText>
            @if (_groupLoadBusy)
            {
                <MudProgressLinear Indeterminate="true" Class="mt-2" />
            }
            @if (!string.IsNullOrWhiteSpace(_groupLoadError))
            {
                <MudAlert Severity="Severity.Error" Class="mt-2">@_groupLoadError</MudAlert>
            }
            <MudList T="RepositoryLoadResultModel" Dense="true">
                @foreach (var result in _groupLoadResults)
                {
                    <MudListItem T="RepositoryLoadResultModel">
                        <MudText Typo="Typo.body2">
                            @($"{result.Name} | {(result.Loaded ? "Loaded" : "Not Loaded")} | {result.Message}")
                        </MudText>
                    </MudListItem>
                }
            </MudList>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudText Typo="Typo.h4" Class="mb-4">Available Repositories</MudText>
<MudPaper Elevation="1" Class="pa-4 mb-6">
    <MudGrid>
        <MudItem xs="12" md="5">
            <MudText Typo="Typo.subtitle1" Class="mb-2">Add to Group</MudText>
            <MudSelect T="string" Label="Repository" @bind-Value="_availableSelectedPath">
                <MudSelectItem T="string" Value="@(string.Empty)">Select a repository</MudSelectItem>
                @foreach (var repo in _availableRepositories)
                {
                    <MudSelectItem T="string" Value="@(repo.FullPath)">
                        @($"{repo.Name} ({repo.RelativePath})")
                    </MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="Guid?" Label="Group" @bind-Value="_availableGroupId">
                <MudSelectItem T="Guid?" Value="@(default(Guid?))">Select a group</MudSelectItem>
                @foreach (var group in _groups)
                {
                    <MudSelectItem T="Guid?" Value="@(group.Id)">@group.Name</MudSelectItem>
                }
            </MudSelect>
            <MudStack Row="true" Class="mt-3" Spacing="2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddAvailableRepositoryAsync" Disabled="_availableBusy">
                    Add
                </MudButton>
            </MudStack>
            @if (!string.IsNullOrWhiteSpace(_availableMessage))
            {
                <MudAlert Severity="Severity.Success" Class="mt-3">@_availableMessage</MudAlert>
            }
            @if (!string.IsNullOrWhiteSpace(_availableError))
            {
                <MudAlert Severity="Severity.Error" Class="mt-3">@_availableError</MudAlert>
            }
        </MudItem>
        <MudItem xs="12" md="7">
            <MudTable Items="_availableRepositories" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh>Relative Path</MudTh>
                    <MudTh>Git</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Name">@context.Name</MudTd>
                    <MudTd DataLabel="Relative Path">@context.RelativePath</MudTd>
                    <MudTd DataLabel="Git">@((context.IsGitRepository) ? "Yes" : "No")</MudTd>
                </RowTemplate>
            </MudTable>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudText Typo="Typo.h4" Class="mb-4">Repository Configs</MudText>
<MudPaper Elevation="1" Class="pa-4">
    <MudGrid>
        <MudItem xs="12" md="5">
            <MudText Typo="Typo.subtitle1" Class="mb-2">@(_editingConfigId is null ? "Create Config" : "Edit Config")</MudText>
            <MudTextField T="string" Label="Name" Required="true" @bind-Value="_configName" />
            <MudTextField T="string" Label="Root Path" Required="true" @bind-Value="_configRootPath" />
            <MudTextField T="string" Label="Description" @bind-Value="_configDescription" Lines="3" />
            <MudSelect T="Guid?" Label="Group" @bind-Value="_configGroupId">
                <MudSelectItem T="Guid?" Value="@(default(Guid?))">None</MudSelectItem>
                @foreach (var group in _groups)
                {
                    <MudSelectItem T="Guid?" Value="@(group.Id)">@group.Name</MudSelectItem>
                }
            </MudSelect>
            <MudStack Row="true" Class="mt-3" Spacing="2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveConfigAsync" Disabled="_configBusy">
                    Save
                </MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="ClearConfigForm" Disabled="_configBusy">
                    Clear
                </MudButton>
            </MudStack>
            @if (!string.IsNullOrWhiteSpace(_configMessage))
            {
                <MudAlert Severity="Severity.Success" Class="mt-3">@_configMessage</MudAlert>
            }
            @if (!string.IsNullOrWhiteSpace(_configError))
            {
                <MudAlert Severity="Severity.Error" Class="mt-3">@_configError</MudAlert>
            }
        </MudItem>
        <MudItem xs="12" md="7">
            <MudTable Items="_configs" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh>Root Path</MudTh>
                    <MudTh>Group</MudTh>
                    <MudTh></MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Name">@context.Name</MudTd>
                    <MudTd DataLabel="Root Path">@context.RootPath</MudTd>
                    <MudTd DataLabel="Group">@GetGroupName(context.GroupId)</MudTd>
                    <MudTd>
                        <MudButton Variant="Variant.Text" OnClick="@(() => StartConfigEdit(context))">Edit</MudButton>
                    </MudTd>
                    <MudTd>
                        <MudButton Variant="Variant.Text" OnClick="@(() => StartLoadAsync(context))" Disabled="_loadBusy">
                            Load
                        </MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
            <MudDivider Class="my-4" />
            <MudText Typo="Typo.subtitle1">Load Progress</MudText>
            @if (_loadBusy)
            {
                <MudProgressLinear Indeterminate="true" Class="mt-2" />
            }
            @if (!string.IsNullOrWhiteSpace(_loadError))
            {
                <MudAlert Severity="Severity.Error" Class="mt-2">@_loadError</MudAlert>
            }
            <MudList T="RepoEventModel" Dense="true">
                @foreach (var evt in _loadEvents)
                {
                    <MudListItem T="RepoEventModel">
                        <MudText Typo="Typo.body2">
                            @($"{evt.Kind} | {evt.Stage} | {evt.Message} ({FormatPercent(evt.Percent)})")
                        </MudText>
                    </MudListItem>
                }
            </MudList>
        </MudItem>
    </MudGrid>
</MudPaper>

@code {
    private readonly List<RepositoryGroupModel> _groups = new();
    private readonly List<RepositoryConfigModel> _configs = new();
    private readonly List<AvailableRepositoryModel> _availableRepositories = new();

    private Guid? _editingGroupId;
    private string _groupName = string.Empty;
    private string? _groupDescription;
    private bool _groupBusy;
    private string? _groupMessage;
    private string? _groupError;
    private readonly List<RepositoryLoadResultModel> _groupLoadResults = new();
    private bool _groupLoadBusy;
    private string? _groupLoadError;

    private Guid? _editingConfigId;
    private string _configName = string.Empty;
    private string _configRootPath = string.Empty;
    private string? _configDescription;
    private Guid? _configGroupId;
    private bool _configBusy;
    private string? _configMessage;
    private string? _configError;
    private string? _availableSelectedPath;
    private Guid? _availableGroupId;
    private bool _availableBusy;
    private string? _availableMessage;
    private string? _availableError;

    private readonly List<RepoEventModel> _loadEvents = new();
    private bool _loadBusy;
    private string? _loadError;
    private CancellationTokenSource? _loadCts;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _groupError = null;
        _configError = null;

        try
        {
            _groups.Clear();
            _groups.AddRange(await Api.GetRepositoryGroupsAsync());

            _configs.Clear();
            _configs.AddRange(await Api.GetRepositoryConfigsAsync());

            _availableRepositories.Clear();
            _availableRepositories.AddRange(await Api.GetAvailableRepositoriesAsync());
        }
        catch (Exception ex)
        {
            _groupError = $"Failed to load data: {ex.Message}";
            _configError = _groupError;
            _availableError = _groupError;
        }
    }

    private async Task SaveGroupAsync()
    {
        _groupMessage = null;
        _groupError = null;

        if (string.IsNullOrWhiteSpace(_groupName))
        {
            _groupError = "Group name is required.";
            return;
        }

        _groupBusy = true;
        try
        {
            if (_editingGroupId is null)
            {
                await Api.CreateRepositoryGroupAsync(new CreateRepositoryGroupRequest(_groupName, _groupDescription));
                _groupMessage = "Group created.";
            }
            else
            {
                await Api.UpdateRepositoryGroupAsync(_editingGroupId.Value,
                    new UpdateRepositoryGroupRequest(_groupName, _groupDescription));
                _groupMessage = "Group updated.";
            }

            ClearGroupForm();
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _groupError = ex.Message;
        }
        finally
        {
            _groupBusy = false;
        }
    }

    private void StartGroupEdit(RepositoryGroupModel group)
    {
        _editingGroupId = group.Id;
        _groupName = group.Name;
        _groupDescription = group.Description;
        _groupMessage = null;
        _groupError = null;
    }

    private void ClearGroupForm()
    {
        _editingGroupId = null;
        _groupName = string.Empty;
        _groupDescription = null;
        _groupMessage = null;
        _groupError = null;
    }

    private async Task StartGroupLoadAsync(RepositoryGroupModel group)
    {
        _groupLoadBusy = true;
        _groupLoadError = null;
        _groupLoadResults.Clear();
        StateHasChanged();

        try
        {
            var result = await Api.LoadRepositoryGroupAsync(group.Id);
            _groupLoadResults.AddRange(result.Repositories);
        }
        catch (Exception ex)
        {
            _groupLoadError = ex.Message;
        }
        finally
        {
            _groupLoadBusy = false;
            StateHasChanged();
        }
    }

    private async Task SaveConfigAsync()
    {
        _configMessage = null;
        _configError = null;

        if (string.IsNullOrWhiteSpace(_configName))
        {
            _configError = "Config name is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_configRootPath))
        {
            _configError = "Root path is required.";
            return;
        }

        _configBusy = true;
        try
        {
            if (_editingConfigId is null)
            {
                await Api.CreateRepositoryConfigAsync(new CreateRepositoryConfigRequest(
                    _configName,
                    _configRootPath,
                    _configDescription,
                    _configGroupId));
                _configMessage = "Config created.";
            }
            else
            {
                await Api.UpdateRepositoryConfigAsync(_editingConfigId.Value, new UpdateRepositoryConfigRequest(
                    _configName,
                    _configRootPath,
                    _configDescription,
                    _configGroupId));
                _configMessage = "Config updated.";
            }

            ClearConfigForm();
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _configError = ex.Message;
        }
        finally
        {
            _configBusy = false;
        }
    }

    private void StartConfigEdit(RepositoryConfigModel config)
    {
        _editingConfigId = config.Id;
        _configName = config.Name;
        _configRootPath = config.RootPath;
        _configDescription = config.Description;
        _configGroupId = config.GroupId;
        _configMessage = null;
        _configError = null;
    }

    private void ClearConfigForm()
    {
        _editingConfigId = null;
        _configName = string.Empty;
        _configRootPath = string.Empty;
        _configDescription = null;
        _configGroupId = null;
        _configMessage = null;
        _configError = null;
    }

    private async Task AddAvailableRepositoryAsync()
    {
        _availableMessage = null;
        _availableError = null;

        if (string.IsNullOrWhiteSpace(_availableSelectedPath))
        {
            _availableError = "Select a repository to add.";
            return;
        }

        if (!_availableGroupId.HasValue)
        {
            _availableError = "Select a group to add the repository.";
            return;
        }

        var selected = _availableRepositories.FirstOrDefault(repo => repo.FullPath == _availableSelectedPath);
        if (selected is null)
        {
            _availableError = "Selected repository not found.";
            return;
        }

        if (!selected.IsGitRepository)
        {
            _availableError = "Selected repository is not a git repository.";
            return;
        }

        _availableBusy = true;
        try
        {
            await Api.CreateRepositoryConfigAsync(new CreateRepositoryConfigRequest(
                selected.Name,
                selected.FullPath,
                null,
                _availableGroupId));
            _availableMessage = "Repository added to group.";
            _availableSelectedPath = null;
            _availableGroupId = null;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _availableError = ex.Message;
        }
        finally
        {
            _availableBusy = false;
        }
    }

    private string GetGroupName(Guid? groupId)
    {
        if (!groupId.HasValue)
        {
            return "None";
        }

        return _groups.FirstOrDefault(group => group.Id == groupId.Value)?.Name ?? "Unknown";
    }

    private static string FormatPercent(double? value)
    {
        return value.HasValue ? $"{value.Value:0.#}%" : "-";
    }

    private async Task StartLoadAsync(RepositoryConfigModel config)
    {
        _loadCts?.Cancel();
        _loadCts = new CancellationTokenSource();
        _loadEvents.Clear();
        _loadError = null;
        _loadBusy = true;
        StateHasChanged();

        try
        {
            await foreach (var evt in Api.LoadRepositoryAsync(config.Id, _loadCts.Token))
            {
                _loadEvents.Add(evt);
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
        finally
        {
            _loadBusy = false;
            StateHasChanged();
        }
    }
}
