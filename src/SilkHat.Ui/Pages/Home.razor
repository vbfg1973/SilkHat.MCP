@page "/"
@inject HttpClient Http

<PageTitle>Dashboard</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Repository Health</MudText>

<MudPaper Elevation="1" Class="pa-4">
    <MudText Typo="Typo.subtitle1">API Status</MudText>
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Class="mt-2" />
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Class="mt-2">@_error</MudAlert>
    }
    else
    {
        <MudAlert Severity="Severity.Success" Class="mt-2">Health: @_health</MudAlert>
    }
</MudPaper>

@code {
    private bool _loading = true;
    private string? _health;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _health = await Http.GetStringAsync("api/health");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
